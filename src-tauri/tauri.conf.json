{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veloct",
  "version": "1.0.0",
  "identifier": "app.veloct.desktop",
  "build": {
    "frontendDist": "../dist-ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm.cmd run dev:ui",
    "beforeBuildCommand": "npm.cmd run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veloct",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:* ; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/icon.png"],
    "externalBin": ["binaries/veloct-astro-sidecar", "binaries/veloct-node"],
    "windows": {
      "bundleVCRuntime": false
    }
  }
}
