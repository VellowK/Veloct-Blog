---
// A tag page.
//
// handoff.md section 6.4 lists 标签页 among the required templates.

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readSiteConfig } from '../../lib/site-config.mjs';
import { byNewest, formatDate, readingStats, isProduction } from '../../lib/format.ts';
import { articleRoute, WipRoute } from '../../lib/content.ts';


export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const options = { isProduction: import.meta.env.PROD };
  const tags = new Map();
  for (const entry of articles) {
    if (articleRoute(entry, options).kind !== WipRoute.Article) continue;
    for (const tag of entry.data.tags ?? []) {
      if (!tags.has(tag)) tags.set(tag, []);
      tags.get(tag).push(entry);
    }
  }
  const site = readSiteConfig();
  return [...tags.entries()].map(([tag, values]) => {
    const entries = values.sort(byNewest);
    return { params: { tag }, props: { tag, page: { data: entries.slice(0, site.tagDisplayCount), total: entries.length, url: { current: `/tags/${encodeURIComponent(tag)}/` } } } };
  });
}

const { tag, page } = Astro.props;
const entries = page.data;
const site = readSiteConfig();
---

<BaseLayout
  title={`#${tag} · ${site.name}`}
  description={`${site.name} 中标签为 ${tag} 的文章`}
  canonical={page.url.current}
>
  <h1 class="font-serif text-2xl">#{tag}</h1>
  <p class="mt-2 muted">{page.total} 篇文章</p>

  <ul class="mt-6 space-y-3">
    {entries.map((entry) => {
      const stats = readingStats(entry.body);
      return (
        <li class="card p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <a href={`/article/${entry.data.slug}/`} class="no-underline">
              <h2 class="font-serif text-base text-ink-100">{entry.data.title}</h2>
            </a>
            <time class="text-xs muted" datetime={entry.data.published_at ?? entry.data.created_at}>
              {formatDate(entry.data.published_at ?? entry.data.created_at)}
            </time>
          </div>
          {entry.data.summary && <p class="mt-2 text-sm text-ink-300">{entry.data.summary}</p>}
          <p class="mt-2 text-xs muted">{stats.words} 字 · 约 {stats.minutes} 分钟</p>
        </li>
      );
    })}
  </ul>
</BaseLayout>
