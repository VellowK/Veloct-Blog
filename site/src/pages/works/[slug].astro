---
// A work's shell page.
//
// handoff.md section 10.3: the shell page has a floating bar showing the work's name, completion
// time, author and a demo declaration, and the work body runs under the independent Works Origin.
//
// handoff.md section 10.4 is the reason the iframe below is sandboxed WITHOUT `allow-same-origin`,
// without `allow-top-navigation`, without `allow-popups` and without `allow-forms`: a work must not
// be able to reach the main site's storage, DOM or session. When no Works Origin is configured the
// page says so plainly instead of loading the work same-origin, which would silently remove the
// isolation the contract requires.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readSiteConfig } from '../../lib/site-config.mjs';
import { formatDate } from '../../lib/format.ts';
import { readWorks } from '../../lib/works.mjs';

export function getStaticPaths() {
  const works = readWorks();
  // A work that silently produces no page would hide a real problem, so the count is logged: the
  // build transcript is the evidence that the works routes were generated at all.
  console.log(`[veloct] works routes: ${works.map((work) => `/works/${work.slug}/`).join(', ') || '(none)'}`);
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const site = readSiteConfig();
const worksOrigin = (site.worksOrigin ?? '').replace(/\/$/, '');
const workUrl = worksOrigin ? `${worksOrigin}/${work.slug}/` : '';
---

<BaseLayout
  title={`${work.title} · 作品`}
  description={work.summary}
  canonical={`/works/${work.slug}/`}
  wide
>
  <!-- The floating bar required by handoff.md section 10.3. -->
  <div class="card-raised sticky top-4 z-10 mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 p-4">
    <h1 class="font-serif text-lg">{work.title}</h1>
    <span class="text-sm muted">
      {work.author}
      {work.completedAt && <span> · 完成于 {formatDate(work.completedAt)}</span>}
    </span>
    <span class="card px-2 py-0.5 text-xs text-accent-400">Demo 声明</span>
    {workUrl && (
      <a href={workUrl} class="ml-auto text-sm" target="_blank" rel="noopener noreferrer">
        在新窗口打开作品本体 ↗
      </a>
    )}
  </div>

  {work.summary && <p class="mt-4 text-ink-300">{work.summary}</p>}

  <div class="mt-6">
    {workUrl ? (
      <>
        <iframe
          src={workUrl}
          /* The minimum sandbox the contract allows. `allow-same-origin` is deliberately absent:
             including it would give the work the main site's origin and defeat the isolation. */
          sandbox="allow-scripts"
          referrerpolicy="no-referrer"
          loading="lazy"
          title={`${work.title} 作品本体`}
          class="h-[70vh] w-full rounded-xl border border-ink-700 bg-ink-900"
        ></iframe>
        <p class="mt-3 text-xs muted">
          作品本体运行在独立的 Works Origin（{worksOrigin}），并通过 sandbox iframe 嵌入。
          它无法访问主站的 DOM、localStorage、会话 Cookie 或 Tauri bridge。
        </p>
      </>
    ) : (
      <div class="card border-accent-600/50 p-6">
        <h2 class="font-serif text-lg text-accent-400">尚未提供强隔离的运行环境</h2>
        <p class="mt-3 text-sm text-ink-300">
          这个部署目标没有配置独立的 Works Origin。按照约定，作品**不会**以主站同源顶层文档的
          方式运行，因此这里不提供内嵌预览。
        </p>
        <p class="mt-3 text-sm text-ink-300">
          配置 Works Origin 后，此处会以 sandbox iframe 嵌入
          <span class="font-mono">{(site.worksOrigin || 'works.example.com')}/{work.slug}/</span>。
        </p>
        <p class="mt-3 text-xs muted">
          作品本体已经包含在发布产物中：<span class="font-mono">dist/works/{work.slug}/</span>
        </p>
      </div>
    )}
  </div>

  {(work.tags?.length > 0 || work.notes) && (
    <section class="mt-8">
      {work.tags?.length > 0 && (
        <p class="flex flex-wrap gap-2">
          {work.tags.map((tag) => (
            <span class="card px-2 py-0.5 text-xs muted">#{tag}</span>
          ))}
        </p>
      )}
      {work.notes && <p class="mt-3 text-sm muted">{work.notes}</p>}
    </section>
  )}
</BaseLayout>
