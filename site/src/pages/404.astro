---
// The 404 page.
//
// handoff.md section 6.4 lists 404 among the required templates. It must not pretend the URL exists,
// and it must offer a way back rather than dead-ending.

import BaseLayout from '../layouts/BaseLayout.astro';
import { readSiteConfig } from '../lib/site-config.mjs';

const site = readSiteConfig();
---

<BaseLayout
  title={`页面不存在 · ${site.name}`}
  description="请求的页面不存在。"
  noindex
>
  <div class="card-raised mt-8 p-8 text-center">
    <p class="font-serif text-5xl text-accent-400">404</p>
    <h1 class="mt-4 font-serif text-2xl">这个页面不存在</h1>
    <p class="mt-3 muted">
      地址可能已经改变，或者从未存在过。如果这是一个已经完成的 WIP 地址，
      它应该会重定向到对应的文章页面。
    </p>
    <nav class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="card px-4 py-2 no-underline">首页</a>
      <a href="/article/" class="card px-4 py-2 no-underline">文章</a>
      <a href="/docs/" class="card px-4 py-2 no-underline">知识库</a>
      <a href="/archive/" class="card px-4 py-2 no-underline">归档</a>
    </nav>
  </div>
</BaseLayout>
