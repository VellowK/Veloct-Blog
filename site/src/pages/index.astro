---
// Profile homepage: the old global sidebar is never mounted here. Managed home Markdown remains
// intact for later reuse; profile description and introduction are deliberately separate settings.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHome from '../components/ProfileHome.astro';
import { readSiteConfig, projectRoot } from '../lib/site-config.mjs';
import { blogActivity, readGithubActivity } from '../lib/profile-home.mjs';

const site = readSiteConfig();
const blog = blogActivity([...(await getCollection('articles')), ...(await getCollection('knowledge'))]);
const github = readGithubActivity(projectRoot, site.homepage.githubUsername);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name,
  url: site.url, description: site.description,
  ...(site.author?.name ? { author: { '@type': 'Person', name: site.author.name } } : {}) };
---
<BaseLayout title={site.name} description={site.description} canonical="/" jsonLd={jsonLd} wide showRightSidebar={false}>
  <ProfileHome site={site} blog={blog} github={github} />
</BaseLayout>
