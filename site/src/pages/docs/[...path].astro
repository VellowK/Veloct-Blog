---
// A knowledge base page.
//
// The route is a rest parameter because a knowledge slug may be nested (handoff.md section 6.3 lists
// `/docs/[...path]`).
//
// Paragraph ids are stripped from the rendered body: they are internal identity used by references
// (section 9.2) and must never be visible to a reader. Each paragraph keeps an `id` attribute so an
// incoming reference can highlight it in the right sidebar.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { directiveComponents } from '../../lib/components.ts';
import { readSiteConfig } from '../../lib/site-config.mjs';
import { citationText } from '../../lib/knowledge.ts';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({
    params: { path: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const site = readSiteConfig();

const { Content, headings } = await render(entry);

const citation = {
  contentId: entry.data.id,
  author: entry.data.author ?? 'Unknown',
  year: entry.data.year ?? (String(entry.data.created_at ?? '').slice(0, 4) || 'n.d.'),
  title: entry.data.title,
  url: entry.data.url ?? null,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.summary ?? '',
  datePublished: entry.data.created_at,
  dateModified: entry.data.updated_at,
  ...(entry.data.author ? { author: { '@type': 'Person', name: entry.data.author } } : {}),
};
---

<BaseLayout
  title={`${entry.data.title} · 知识库`}
  description={entry.data.summary}
  canonical={`/docs/${entry.data.slug}/`}
  type="article"
  publishedAt={entry.data.created_at}
  updatedAt={entry.data.updated_at}
  tags={entry.data.tags}
  jsonLd={jsonLd}
  headings={headings.map((heading) => ({ depth: heading.depth, slug: heading.slug, text: heading.text }))}
>
  <nav class="mt-4 text-sm muted" aria-label="面包屑">
    <a href="/docs/">知识库</a>
    <span class="mx-2">/</span>
    <span>{entry.data.title}</span>
  </nav>

  <header class="mt-4">
    <h1 class="font-serif text-2xl leading-tight">{entry.data.title}</h1>
    {entry.data.summary && <p class="mt-3 text-ink-300">{entry.data.summary}</p>}
    <p class="mt-3 text-sm muted">
      {entry.data.author && <span>{entry.data.author} · </span>}
      <span>{citation.year}</span>
    </p>
  </header>

  <div class="prose-veloct mt-8" data-veloct-knowledge-body>
    <Content />
  </div>

  <!-- The citation form, so a reader can reuse it and so the reference list on an article has a
       visible counterpart here. Deliberately NOT a list of citing articles: handoff.md section 9.4
       says a knowledge page does not show which articles cite it. -->
  <section class="mt-10 border-t border-ink-800 pt-4" aria-labelledby="veloct-citation">
    <h2 id="veloct-citation" class="font-serif text-base">引用格式</h2>
    <p class="mt-2 text-sm text-ink-300">{citationText(citation)}</p>
  </section>
</BaseLayout>

<script>
  // A paragraph's stable id is removed from the body before Markdown is parsed (so it can never be
  // visible to a reader), so the DOM does not carry ids. What it does carry is the ordinal of each
  // block: the plugin tags every paragraph with `data-veloct-block`, and a reference card resolves a
  // paragraph id to its ordinal through the generated knowledge index.
  //
  // This is deliberately positional rather than textual. Matching on the paragraph's TEXT would move
  // the highlight the moment the author reworded it, which is exactly the "guess a different
  // paragraph" behaviour handoff.md section 9.3 forbids.
  (function () {
    const body = document.querySelector('[data-veloct-knowledge-body]');
    if (!body) return;

    document.addEventListener('veloct:open-knowledge', (event) => {
      const detail = (event as CustomEvent).detail ?? {};
      const order = String(detail.paragraphId ?? '');
      if (!order) return;

      const target = body.querySelector<HTMLElement>(`[data-veloct-block="${order}"]`);
      // No target means the reference is broken. Highlight nothing rather than picking a neighbour.
      if (!target) {
        console.warn(`[veloct] reference block ${order} not found in this knowledge page`);
        return;
      }

      target.classList.add('ring-2', 'ring-accent-500', 'rounded');
      target.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  })();
</script>
