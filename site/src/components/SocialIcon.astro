---
// One social glyph, for a contact's `icon` key.
//
// The catalogue lives in `../lib/social-platforms` and is shared with the desktop form, so the icon
// the user picks in 站点信息 is the icon drawn here. A second list on this side would be able to
// disagree with the picker, which is the failure this arrangement removes.
//
// Simple Icons paths are FILLED 24×24 shapes rather than strokes, so this is the one inline SVG in
// the template that is drawn with `fill` and not with the `stroke` the navigation icons use.

import { findSocialPlatform } from '../lib/social-platforms';

interface Props {
  /** The `icon` key stored on a contact. An absent or unknown key draws nothing. */
  name?: string | null;
  size?: number;
}

const { name = null, size = 16 } = Astro.props;
const platform = findSocialPlatform(name);
---

{platform && (platform.path ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d={platform.path} />
  </svg>
) : (
  // A platform with no published icon (抖音) is drawn as its own first character. Borrowing another
  // product's logo would be a claim this file cannot support, and an empty box would read as a bug.
  <span class="social-icon-letter" style={`width:${size}px;height:${size}px`} aria-hidden="true">
    {platform.label.slice(0, 1)}
  </span>
))}

<style>
  .social-icon-letter {
    display: inline-grid;
    place-items: center;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.1);
    font-size: 10px;
    line-height: 1;
  }
</style>
